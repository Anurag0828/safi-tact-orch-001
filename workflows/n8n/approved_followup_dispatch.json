{
  "name": "SAFI Approved Follow-Up Dispatcher (Gate-Authorized Only - R-MKT-02)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "safi-approved-followup",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-followup",
      "webhookId": "safi-approved-followup-wh-001",
      "name": "Gate-Authorized Follow-Up Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "notes": "Bound to 127.0.0.1/local network and strictly guarded by Verify Gate Secret & Approval node (R-GATE-01, R-SEC-02)."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-secret-nonempty",
              "leftValue": "={{ $env.N8N_WEBHOOK_SECRET || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "cond-secret-match",
              "leftValue": "={{ $json.headers['x-safi-webhook-secret'] || '' }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET || '' }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-gate-approved",
              "leftValue": "={{ $json.body.gateApproved === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-verify-gate-auth",
      "name": "Verify Gate Secret & Approval",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300],
      "notes": "Blocks direct unauthenticated calls or gateApproved!=true bypass attempts (R-GATE-01, R-SEC-02)."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'dispatched', executionId: $execution.id, conversationId: $json.body.conversationId, recipientEmail: $json.body.recipientEmail, idempotencyKey: $json.body.idempotencyKey, gateApproved: true, dispatchedAt: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-dispatched",
      "name": "Confirm Verified Follow-Up Status",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ errorCode: 'GATE_BYPASS_REJECTED', message: 'Direct webhook call rejected: valid X-SAFI-Webhook-Secret and gateApproved=true are required' }) }}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "node-reject-bypass",
      "name": "Reject Direct Gate Bypass",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 420]
    }
  ],
  "connections": {
    "Gate-Authorized Follow-Up Webhook": {
      "main": [
        [{ "node": "Verify Gate Secret & Approval", "type": "main", "index": 0 }]
      ]
    },
    "Verify Gate Secret & Approval": {
      "main": [
        [{ "node": "Confirm Verified Follow-Up Status", "type": "main", "index": 0 }],
        [{ "node": "Reject Direct Gate Bypass", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
