# SAFI-TACT-ORCH-001 Environment Template (SECRET-FREE - R-SEC-03, R-ENV-02)
# Copy to deploy/.env and fill with strong, non-default, least-privilege credentials.
# NEVER commit deploy/.env to Git.

# --- Gate Adapter Endpoint Auth & Fail-Closed Policy (R-SEC-02, R-SEC-04, A09) ---
GATE_API_TOKEN=replace_with_32_byte_random_gate_api_token
GATE_REQUIRE_AUTH=true
# Use AUTHZ_MODE=http with SAFI_AUTHZ_URL in SAFI environment; use AUTHZ_MODE=local_acl for local default-deny ACL
AUTHZ_MODE=http
LOCAL_ACL_JSON={"bootstrapActors":["user_safi_pilot_owner_01"],"proxyActors":["proxy-n8n-workflow"],"conversations":{},"revokedActors":[]}

# --- Recipient Allowlist (R-SEC-01: explicit consenting test contacts only) ---
SAFI_ALLOWED_RECIPIENTS=customer-a@allowlist.test.local,customer-b@allowlist.test.local,customer-c@allowlist.test.local,ops-specialist-1@allowlist.test.local

# --- n8n (Marketing - admin owner created via User Management on first launch) ---
N8N_ENCRYPTION_KEY=replace_with_32_byte_random_hex
N8N_API_KEY=replace_with_n8n_api_key
N8N_WEBHOOK_SECRET=replace_with_random_webhook_secret

# --- Calnode (Sales - https://github.com/Calnode/calnode) ---
CALNODE_PINNED_IMAGE=ghcr.io/calnode/calnode@sha256:120f1434d02c409b25f981a163cd4408db3e3f3ea571abc4c1e3e922f292af80
CALNODE_ENCRYPTION_KEY=replace_with_64_hex_char_32_byte_key
CALNODE_RECOVERY_SECRET=replace_with_64_hex_char_32_byte_secret
CALNODE_API_KEY=replace_with_calnode_api_key
CALNODE_CALENDAR_ID=consultation-30m

# --- Windmill (Operations — use a least-privilege workspace operator token, NOT superadmin) ---
WINDMILL_DB_USER=windmill_svc
WINDMILL_DB_PASSWORD=replace_with_strong_db_password
WINDMILL_ADMIN_EMAIL=replace_with_non_default_email
WINDMILL_ADMIN_PASSWORD=replace_with_strong_unique_password
WINDMILL_TOKEN=replace_with_least_privilege_workspace_operator_token
WINDMILL_WORKSPACE=safi-ops

# --- SAFI Backend (NATS / JetStream / Permission Recheck) ---
# Fill during Phase 0 Preflight (V-06, V-07, V-08)
NATS_URL=nats://127.0.0.1:4222
NATS_TOKEN=
NATS_USER=
NATS_PASSWORD=
JETSTREAM_STREAM=SAFI_HISTORY
JETSTREAM_CONTROL_SUBJECT_PREFIX=safi.control.events
JETSTREAM_REQUIRED=true
# Keep false against SAFI's production NATS; set true ONLY for standalone local-nats testing
JETSTREAM_AUTO_CREATE_STREAM=false
SAFI_AUTHZ_URL=
SAFI_AUTHZ_TOKEN=
