# SAFI-TACT-ORCH-001 Environment Template (SECRET-FREE - R-SEC-03, R-ENV-02)
# Copy to deploy/.env and fill with strong, non-default, least-privilege credentials.
# NEVER commit deploy/.env to Git.

# --- Recipient Allowlist (R-SEC-01: explicit consenting test contacts only) ---
SAFI_ALLOWED_RECIPIENTS=customer-a@allowlist.test.local,customer-b@allowlist.test.local,customer-c@allowlist.test.local,ops-specialist-1@allowlist.test.local

# --- n8n (Marketing) ---
N8N_ADMIN_USER=replace_with_non_default_admin
N8N_ADMIN_PASSWORD=replace_with_strong_unique_password
N8N_ENCRYPTION_KEY=replace_with_32_byte_random_hex
N8N_API_KEY=replace_with_n8n_api_key
N8N_WEBHOOK_SECRET=replace_with_random_webhook_secret

# --- Calnode (Sales) ---
CALNODE_PINNED_IMAGE=replace_with_verified_calnode_image_and_digest
CALNODE_ADMIN_EMAIL=replace_with_non_default_email
CALNODE_ADMIN_PASSWORD=replace_with_strong_unique_password
CALNODE_API_KEY=replace_with_calnode_api_key
CALNODE_CALENDAR_ID=cal_test_bounded_01

# --- Windmill (Operations) ---
WINDMILL_DB_USER=windmill_svc
WINDMILL_DB_PASSWORD=replace_with_strong_db_password
WINDMILL_ADMIN_EMAIL=replace_with_non_default_email
WINDMILL_ADMIN_PASSWORD=replace_with_strong_unique_password
WINDMILL_TOKEN=replace_with_windmill_api_token
WINDMILL_WORKSPACE=safi-ops

# --- SAFI Backend (NATS / JetStream / Permission Recheck) ---
# Fill during Phase 0 Preflight (V-06, V-07, V-08)
NATS_URL=nats://127.0.0.1:4222
NATS_TOKEN=
NATS_USER=
NATS_PASSWORD=
JETSTREAM_STREAM=SAFI_HISTORY
JETSTREAM_CONTROL_SUBJECT_PREFIX=safi.control.events
SAFI_AUTHZ_URL=
SAFI_AUTHZ_TOKEN=
